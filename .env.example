# ==============================================================================
# MediLedger Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# DO NOT COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Backend Database Configuration (PostgreSQL - Local Docker or Aiven Cloud)
DATABASE_URL=jdbc:postgresql://localhost:5432/mediledger
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Backend Security / JWT Configuration (Min 256-bit base64 secret in production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# Backend Server & CORS Configuration
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:8080/api
