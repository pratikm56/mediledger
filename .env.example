# ==============================================================================
# MediLedger Global Environment Configuration Reference
# ==============================================================================

# Active Spring Profile (prod for production, default for local)
SPRING_PROFILES_ACTIVE=prod

# Server Port (Render sets this dynamically, default is 8080)
PORT=8080
SERVER_PORT=8080

# PostgreSQL Database Configuration (Local Docker or Aiven Cloud)
# For Aiven Cloud: jdbc:postgresql://<host>:<port>/<dbname>?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mediledger
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Alternative environment variable names recognized by Spring Boot:
DATABASE_URL=jdbc:postgresql://localhost:5432/mediledger
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Security / JWT Secret (256-bit hexadecimal string)
# Generate via: openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# CORS Allowed Origins (Comma-separated list of allowed frontend origins)
CORS_ALLOWED_ORIGINS=https://mediledger.vercel.app,http://localhost:5173

# Frontend API Base URL (Configured in Vercel project environment settings)
VITE_API_BASE_URL=https://mediledger-backend.onrender.com/api
