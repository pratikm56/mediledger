# ==============================================================================
# MediLedger Backend Environment Variables
# Copy to .env or configure in Render Dashboard Environment Settings
# ==============================================================================

# Spring Profile ('prod' for production deployment, 'default' for local development)
SPRING_PROFILES_ACTIVE=prod

# Server Port (Render injects this dynamically, default is 8080)
PORT=8080

# PostgreSQL Connection (Aiven Cloud or Local Docker)
# For Aiven: jdbc:postgresql://<aiven-host>:<port>/<dbname>?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mediledger
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Alternatively, standard DATABASE_URL can also be used:
# DATABASE_URL=jdbc:postgresql://localhost:5432/mediledger
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=postgres

# Security / JWT Secret (256-bit HMAC key in hexadecimal or base64)
# Generate via: openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# JWT Expiration in milliseconds (Default: 86400000 = 24 hours)
JWT_EXPIRATION=86400000

# CORS Allowed Origins (Comma-separated list of allowed frontend URLs)
# Example for Vercel production deployment:
CORS_ALLOWED_ORIGINS=https://mediledger.vercel.app,http://localhost:5173

# Swagger / OpenAPI UI in production (true/false)
SWAGGER_ENABLED=false
